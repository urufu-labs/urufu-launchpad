{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "keeper/Dockerfile",
    "buildContext": ".",
    "watchPatterns": ["keeper/**", "pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
