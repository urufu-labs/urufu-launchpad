pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";

interface ISafeView {
    function getOwners() external view returns (address[] memory);
    function isModuleEnabled(
        address module
    ) external view returns (bool);
}

interface IRolesView {
    function owner() external view returns (address);
    function avatar() external view returns (address);
    function target() external view returns (address);
}

interface IERC20View {
    function balanceOf(
        address account
    ) external view returns (uint256);
}

interface IBatchView {
    function deposits(
        address user
    ) external view returns (uint256);
}

/// @notice Autonomous agent accounts (docs/PLAN-agents-and-swarms.md 2.4, threats
///         T2 + T13), replayed on a Robinhood mainnet fork.
///
///         `fixtures/agent-policy.json` is generated by
///         web/scripts/agent-policy-fixture.mjs from the same TypeScript builder the
///         agent API uses (web/src/lib/agentV2/agentPolicy.ts). It sets up a real
///         Safe 1.4.1 + Zodiac Roles v2.1.0 policy and then scripts the agent:
///         allowed trades must succeed; cap + 1 wei, the daily cap, non-allowlisted
///         targets and tokens, a foreign recipient, hook or fee tier, a foreign
///         approve spender, delegatecall, policy edits, an outsider, and any call
///         after revoke must revert. No contract in src/ is touched.
contract AgentPolicyForkTest is Test {
    uint256 internal constant RH_CHAIN_ID = 4663;

    struct Step {
        string label;
        uint8 from;
        address to;
        uint256 value;
        bytes data;
        bool expectOk;
        /// Exact revert the policy must give (selector + first word for
        /// ConditionViolation), so a forbidden step can't pass by failing elsewhere.
        bytes expectRevert;
        uint64 warpBefore;
    }

    function setUp() public {
        string memory rpc;
        try vm.envString("ROBINHOOD_RPC_URL") returns (string memory r) {
            rpc = r;
        } catch {}
        if (bytes(rpc).length == 0) rpc = "https://rpc.mainnet.chain.robinhood.com";
        try vm.createSelectFork(rpc) {}
        catch {
            vm.skip(true);
        }
        if (block.chainid != RH_CHAIN_ID) vm.skip(true);
    }

    function test_agentPolicy_capsAllowlistRecipientRevoke() public {
        string memory json = vm.readFile("test/agent/fixtures/agent-policy.json");
        address[3] memory actors = [
            vm.parseJsonAddress(json, ".owner"),
            vm.parseJsonAddress(json, ".agent"),
            vm.parseJsonAddress(json, ".outsider")
        ];
        address safe = vm.parseJsonAddress(json, ".safe");
        address roles = vm.parseJsonAddress(json, ".roles");
        Step[] memory steps = abi.decode(vm.parseJsonBytes(json, ".steps"), (Step[]));
        assertEq(steps.length, vm.parseJsonUint(json, ".stepCount"), "fixture step count");

        vm.deal(actors[0], 100 ether);
        vm.deal(actors[1], 1 ether);
        vm.deal(actors[2], 10 ether);

        for (uint256 i = 0; i < steps.length; i++) {
            Step memory s = steps[i];
            if (s.warpBefore > 0) {
                vm.warp(block.timestamp + s.warpBefore);
                vm.roll(block.number + 1);
            }
            vm.prank(actors[s.from]);
            (bool ok, bytes memory ret) = s.to.call{value: s.value}(s.data);
            assertEq(ok, s.expectOk, s.label);
            if (!ok) {
                assertGe(ret.length, s.expectRevert.length, s.label);
                assertEq(_prefix(ret, s.expectRevert.length), s.expectRevert, s.label);
            }

            if (i == 3) {
                // After setup: owner-only Safe, Roles enabled, owned by and acting on the Safe.
                address[] memory owners = ISafeView(safe).getOwners();
                assertEq(owners.length, 1, "one Safe owner");
                assertEq(owners[0], actors[0], "Safe owner is the human");
                assertTrue(ISafeView(safe).isModuleEnabled(roles), "Roles enabled on the Safe");
                assertEq(IRolesView(roles).owner(), safe, "Roles owned by the Safe");
                assertEq(IRolesView(roles).avatar(), safe, "Roles avatar is the Safe");
                assertEq(IRolesView(roles).target(), safe, "Roles target is the Safe");
                assertEq(safe.balance, 2 ether, "Safe funded");
            }
        }

        // Everything the agent bought or claimed sits in the Safe, never with the agent.
        address curveToken = vm.parseJsonAddress(json, ".curveToken");
        address poolToken = vm.parseJsonAddress(json, ".poolToken");
        address fairToken = vm.parseJsonAddress(json, ".fairToken");
        assertGt(IERC20View(curveToken).balanceOf(safe), 0, "curve buys landed in the Safe");
        assertGt(IERC20View(poolToken).balanceOf(safe), 0, "v4 buy landed in the Safe");
        assertGt(IERC20View(fairToken).balanceOf(safe), 0, "batch claim landed in the Safe");
        assertEq(IERC20View(curveToken).balanceOf(actors[1]), 0, "agent holds nothing");
        assertEq(IERC20View(poolToken).balanceOf(actors[1]), 0, "agent holds nothing");
        assertEq(
            IBatchView(vm.parseJsonAddress(json, ".fairBatch")).deposits(safe),
            0.02 ether,
            "batch deposit credited to the Safe"
        );
        // Total ETH the agent moved out of the Safe stays within what the caps allowed.
        assertGt(safe.balance, 2 ether - 0.4 ether, "spend bounded by caps");
    }

    function _prefix(
        bytes memory b,
        uint256 n
    ) private pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i = 0; i < n; i++) {
            out[i] = b[i];
        }
    }
}
