pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";

interface IERC20Lite {
    function balanceOf(
        address account
    ) external view returns (uint256);
}

interface IFairCurveLite {
    function launcher() external view returns (address);
    function graduated() external view returns (bool);
    function graduationTargetEth() external view returns (uint256);
    function ethReserve() external view returns (uint256);
    function tradeFeeBps() external view returns (uint16);
    function buy(
        uint256 minTokensOut
    ) external payable returns (uint256);
}

interface IFairHookLite {
    function pools(
        bytes32 id
    )
        external
        view
        returns (
            address token,
            address creator,
            uint64 launchTs,
            uint32 antiSniperSeconds,
            uint24 fee,
            int24 tickSpacing,
            bool configured,
            bool forfeited,
            uint256 creatorBaseline
        );
    function creatorFees(
        bytes32 id
    ) external view returns (uint128 pendingEth, uint128 pendingToken, uint128 claimableEth, uint128 claimableToken);
    function isForfeited(
        bytes32 id
    ) external view returns (bool);
    function pokeForfeit(
        bytes32 id
    ) external returns (bool);
}

interface ISafeExec {
    function execTransaction(
        address to,
        uint256 value,
        bytes calldata data,
        uint8 operation,
        uint256 safeTxGas,
        uint256 baseGas,
        uint256 gasPrice,
        address gasToken,
        address refundReceiver,
        bytes memory signatures
    ) external payable returns (bool);
}

struct PoolKeyLite {
    address currency0;
    address currency1;
    uint24 fee;
    int24 tickSpacing;
    address hooks;
}

interface IV4SwapRouterLite {
    function swapExactTokenForETH(
        PoolKeyLite calldata key,
        uint256 amountIn,
        uint256 minOut,
        address recipient,
        uint256 deadline
    ) external returns (uint256);
}

/// @notice Phase 2 agent tokens (docs/PLAN-agents-and-swarms.md 3.4), replayed on a
///         Robinhood mainnet fork against the live Fair lane.
///
///         `fixtures/agent-token.json` is generated by web/scripts/agent-token-fixture.mjs
///         from the same builder the agent API uses (agentTokenLaunchCalls in
///         web/src/lib/agentV2/agentPolicy.ts). An agent account's Safe launches its own
///         Fair token in one owner Safe tx that also lists it for the agent with selling
///         off. Then:
///           A  the agent deposits, settles, claims and buys; approve, transfer and
///              curve sell of its own token are refused by the policy;
///           -  (here) the curve graduates into the live FairHookHost pool;
///           B  outsiders trade the pool, the agent buys on v4; v4 sell and approve
///              are refused;
///           C  the agent claims the creator fee, which lands in the Safe;
///           -  (here) the OWNER overrides and sells most of the Safe's tokens: the
///              Fair forfeit fires and the creator fee is burned from then on.
///         No contract in src/ is touched.
contract AgentTokenForkTest is Test {
    uint256 internal constant RH_CHAIN_ID = 4663;

    struct Step {
        string label;
        uint8 from;
        address to;
        uint256 value;
        bytes data;
        bool expectOk;
        bytes expectRevert;
        uint64 warpBefore;
    }

    string internal json;
    address[3] internal actors;

    function setUp() public {
        string memory rpc;
        try vm.envString("ROBINHOOD_RPC_URL") returns (string memory r) {
            rpc = r;
        } catch {}
        if (bytes(rpc).length == 0) rpc = "https://rpc.mainnet.chain.robinhood.com";
        try vm.createSelectFork(rpc) {}
        catch {
            vm.skip(true);
        }
        if (block.chainid != RH_CHAIN_ID) vm.skip(true);
    }

    function test_agentToken_launchEarnClaimAndForfeit() public {
        json = vm.readFile("test/agent/fixtures/agent-token.json");
        actors = [
            vm.parseJsonAddress(json, ".owner"),
            vm.parseJsonAddress(json, ".agent"),
            vm.parseJsonAddress(json, ".outsider")
        ];
        address safe = vm.parseJsonAddress(json, ".safe");
        address token = vm.parseJsonAddress(json, ".token");
        IFairCurveLite curve = IFairCurveLite(vm.parseJsonAddress(json, ".curve"));
        bytes32 poolId = vm.parseJsonBytes32(json, ".poolId");
        IFairHookLite hook = IFairHookLite(vm.parseJsonAddress(json, ".fairHookHost"));
        address router = vm.parseJsonAddress(json, ".v4SwapRouter");

        vm.deal(actors[0], 100 ether);
        vm.deal(actors[1], 1 ether);
        vm.deal(actors[2], 10 ether);

        // ---- A
        _run(".stepsA", ".stepCountA");
        assertEq(curve.launcher(), safe, "the Safe is the token's creator");
        uint256 held = IERC20Lite(token).balanceOf(safe);
        assertGt(held, 0, "batch claim + curve buy landed in the Safe");
        assertEq(IERC20Lite(token).balanceOf(actors[1]), 0, "agent holds nothing");

        // ---- graduate into the live FairHookHost pool
        _graduate(curve);
        (,,, uint32 gate,,, bool configured, bool forfeitedAtGrad, uint256 baseline) = hook.pools(poolId);
        assertTrue(configured, "pool configured by the live graduator");
        assertFalse(forfeitedAtGrad, "the Safe kept its tokens: not forfeited");
        assertEq(baseline, held, "creator baseline = what the Safe held at graduation");
        vm.warp(block.timestamp + uint256(gate) + 1);
        vm.roll(block.number + 1);

        // ---- B
        _run(".stepsB", ".stepCountB");
        (uint128 pEth, uint128 pTok, uint128 cEth, uint128 cTok) = hook.creatorFees(poolId);
        assertGt(uint256(pEth) + cEth, 0, "ETH creator fee accrued from pool sells");
        assertGt(uint256(pTok) + cTok, 0, "token creator fee accrued from pool buys");

        // ---- C
        uint256 ethBefore = safe.balance;
        uint256 tokBefore = IERC20Lite(token).balanceOf(safe);
        _run(".stepsC", ".stepCountC");
        assertGt(safe.balance, ethBefore, "ETH creator fee paid into the Safe");
        assertGt(IERC20Lite(token).balanceOf(safe), tokBefore, "token creator fee paid into the Safe");
        assertEq(actors[1].balance, 1 ether, "agent got nothing");
        assertFalse(hook.isForfeited(poolId), "still earning");

        // ---- the owner overrides the policy and sells: the Fair forfeit fires
        uint256 bal = IERC20Lite(token).balanceOf(safe);
        uint256 amount = bal / 2;
        _ownerSafeCall(safe, token, abi.encodeWithSignature("approve(address,uint256)", router, amount));
        _ownerSafeCall(
            safe,
            router,
            abi.encodeCall(
                IV4SwapRouterLite.swapExactTokenForETH,
                (PoolKeyLite(address(0), token, 3000, 60, address(hook)), amount, 0, safe, block.timestamp + 1)
            )
        );
        vm.roll(block.number + 1);
        vm.prank(actors[2]);
        hook.pokeForfeit(poolId);
        assertTrue(hook.isForfeited(poolId), "owner sale below the floor forfeits the creator fee");
    }

    // ---------------------------------------------------------------- helpers

    function _run(
        string memory key,
        string memory countKey
    ) internal {
        Step[] memory steps = abi.decode(vm.parseJsonBytes(json, key), (Step[]));
        assertEq(steps.length, vm.parseJsonUint(json, countKey), "fixture step count");
        for (uint256 i = 0; i < steps.length; i++) {
            Step memory s = steps[i];
            if (s.warpBefore > 0) {
                vm.warp(block.timestamp + s.warpBefore);
                vm.roll(block.number + 1);
            }
            vm.prank(actors[s.from]);
            (bool ok, bytes memory ret) = s.to.call{value: s.value}(s.data);
            assertEq(ok, s.expectOk, s.label);
            if (!ok) {
                assertGe(ret.length, s.expectRevert.length, s.label);
                assertEq(_prefix(ret, s.expectRevert.length), s.expectRevert, s.label);
            }
        }
    }

    function _graduate(
        IFairCurveLite curve
    ) internal {
        address whale = makeAddr("agent-token-grad-whale");
        uint256 need = curve.graduationTargetEth() - curve.ethReserve();
        uint256 gross = (need * 10_000) / (10_000 - curve.tradeFeeBps()) + 0.01 ether;
        vm.deal(whale, gross);
        vm.prank(whale);
        curve.buy{value: gross}(0);
        assertTrue(curve.graduated(), "graduated");
        vm.roll(block.number + 1);
    }

    /// Owner-sent Safe tx (plain call) with the "approved by sender" signature.
    function _ownerSafeCall(
        address safe,
        address to,
        bytes memory data
    ) internal {
        bytes memory sig = abi.encodePacked(bytes32(uint256(uint160(actors[0]))), bytes32(0), uint8(1));
        vm.prank(actors[0]);
        assertTrue(
            ISafeExec(safe).execTransaction(to, 0, data, 0, 0, 0, 0, address(0), address(0), sig), "owner Safe tx"
        );
    }

    function _prefix(
        bytes memory b,
        uint256 n
    ) private pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i = 0; i < n; i++) {
            out[i] = b[i];
        }
    }
}
