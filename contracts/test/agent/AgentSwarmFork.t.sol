pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";

import {SwarmVault} from "src/swarm/SwarmVault.sol";

interface ILiveFairFactorySwarm {
    function ethFeeFor(
        address launcher
    ) external view returns (uint256);
    function launch(
        string calldata name,
        string calldata symbol
    ) external payable returns (address token, address curve, address batch);
}

interface ILiveBatchSwarm {
    function deposit() external payable;
    function closeTs() external view returns (uint64);
}

interface IERC20Swarm {
    function balanceOf(
        address
    ) external view returns (uint256);
}

/// @notice Phase 3 with agents (docs/PLAN-agents-and-swarms.md §4): two autonomous agent
///         accounts (Safe 1.4.1 + Zodiac Roles v2.1.0, the phase 1c policy) run a whole
///         swarm on a Robinhood fork, against the live FairLaunchFactory.
///
///         `fixtures/agent-swarm.json` is generated by web/scripts/agent-swarm-fixture.mjs
///         from the agent API's own builders (agentPolicy.ts swarmPermissionCalls,
///         swarmTools.ts buildCreateSwarmTx). The SwarmVaultFactory isn't deployed yet,
///         so it is placed at the fixture's address here. Then:
///           A  the swarm is created; both owners set up accounts and allow the swarm;
///              an agent can't join before it is allowed, can't join over its per-trade
///              cap, can't join another swarm; the agents join, one leaves (ETH back to
///              its Safe) and rejoins, both vote yes;
///           -  (here) past the vote, the named creator launches through the live factory;
///           B  an agent puts the pool into the opening batch;
///           -  (here) someone else deposits too; the batch window closes;
///           C  an agent collects for the swarm, both take their share.
///         Everything lands in the Safes; the agent keys hold nothing.
contract AgentSwarmForkTest is Test {
    uint256 internal constant RH_CHAIN_ID = 4663;

    struct Step {
        string label;
        uint8 from;
        address to;
        uint256 value;
        bytes data;
        bool expectOk;
        bytes expectRevert;
        uint64 warpBefore;
    }

    string internal json;
    address[5] internal actors;

    function setUp() public {
        string memory rpc;
        try vm.envString("ROBINHOOD_RPC_URL") returns (string memory r) {
            rpc = r;
        } catch {}
        if (bytes(rpc).length == 0) rpc = "https://rpc.mainnet.chain.robinhood.com";
        try vm.createSelectFork(rpc) {}
        catch {
            vm.skip(true);
        }
        if (block.chainid != RH_CHAIN_ID) vm.skip(true);
    }

    function test_agentSwarm_twoAgentAccountsRunASwarm() public {
        json = vm.readFile("test/agent/fixtures/agent-swarm.json");
        actors = [
            vm.parseJsonAddress(json, ".owner1"),
            vm.parseJsonAddress(json, ".owner2"),
            vm.parseJsonAddress(json, ".agent1"),
            vm.parseJsonAddress(json, ".agent2"),
            vm.parseJsonAddress(json, ".outsider")
        ];
        address fair = vm.parseJsonAddress(json, ".fairFactory");
        deployCodeTo(
            "SwarmVaultFactory.sol:SwarmVaultFactory", abi.encode(fair), vm.parseJsonAddress(json, ".swarmFactory")
        );

        address safe1 = vm.parseJsonAddress(json, ".safe1");
        address safe2 = vm.parseJsonAddress(json, ".safe2");
        SwarmVault vault = SwarmVault(payable(vm.parseJsonAddress(json, ".vault")));
        address creator = vm.parseJsonAddress(json, ".creator");
        for (uint256 i; i < 4; i++) {
            vm.deal(actors[i], 10 ether);
        }

        // ---- A
        _run(".stepsA", ".stepCountA");
        assertEq(vault.creator(), creator, "the fixture's vault is the swarm that was created");
        assertEq(vault.deposits(safe1), 0.05 ether, "agent 1's Safe is the member");
        assertEq(vault.deposits(safe2), 0.05 ether, "agent 2's Safe is the member (after leave + rejoin)");
        assertEq(vault.pool(), 0.1 ether);
        assertEq(vault.deposits(actors[2]) + vault.deposits(actors[3]), 0, "agent keys are never members");
        assertTrue(vault.passed(), "both voted yes");

        // ---- the named creator launches after the vote
        vm.warp(uint256(vault.joinDeadline()));
        vm.roll(block.number + 1);
        uint256 fee = ILiveFairFactorySwarm(fair).ethFeeFor(creator);
        vm.deal(creator, fee + 0.05 ether);
        vm.prank(creator);
        (address token,, address batch) = ILiveFairFactorySwarm(fair).launch{value: fee + 0.05 ether}(
            vm.parseJsonString(json, ".name"), vm.parseJsonString(json, ".ticker")
        );
        assertEq(batch, vault.batch());

        // ---- B
        _run(".stepsB", ".stepCountB");
        assertTrue(vault.joined());

        // ---- others deposit; the window closes
        address other = makeAddr("agent-swarm-other");
        vm.deal(other, 0.3 ether);
        vm.prank(other);
        ILiveBatchSwarm(batch).deposit{value: 0.3 ether}();
        vm.warp(uint256(ILiveBatchSwarm(batch).closeTs()) + 1);
        vm.roll(block.number + 1);

        // ---- C
        _run(".stepsC", ".stepCountC");
        uint256 got1 = IERC20Swarm(token).balanceOf(safe1);
        uint256 got2 = IERC20Swarm(token).balanceOf(safe2);
        assertGt(got1, 0, "agent 1's share landed in its Safe");
        assertEq(got1, got2, "equal deposits, equal shares");
        assertEq(got1, vault.tokensReceived() / 2);
        assertEq(
            IERC20Swarm(token).balanceOf(actors[2]) + IERC20Swarm(token).balanceOf(actors[3]),
            0,
            "agent keys hold nothing"
        );
    }

    function _run(
        string memory key,
        string memory countKey
    ) internal {
        Step[] memory steps = abi.decode(vm.parseJsonBytes(json, key), (Step[]));
        assertEq(steps.length, vm.parseJsonUint(json, countKey), "fixture step count");
        for (uint256 i = 0; i < steps.length; i++) {
            Step memory s = steps[i];
            if (s.warpBefore > 0) {
                vm.warp(block.timestamp + s.warpBefore);
                vm.roll(block.number + 1);
            }
            vm.prank(actors[s.from]);
            (bool ok, bytes memory ret) = s.to.call{value: s.value}(s.data);
            assertEq(ok, s.expectOk, s.label);
            if (!ok) {
                assertGe(ret.length, s.expectRevert.length, s.label);
                assertEq(_prefix(ret, s.expectRevert.length), s.expectRevert, s.label);
            }
        }
    }

    function _prefix(
        bytes memory b,
        uint256 n
    ) private pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i = 0; i < n; i++) {
            out[i] = b[i];
        }
    }
}
