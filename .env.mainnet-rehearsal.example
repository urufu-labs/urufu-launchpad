# =============================================================================
# urufu launchpad - private Ethereum-mainnet tiny rehearsal
# =============================================================================
# Copy to `.env.mainnet-rehearsal` and fill the blanks:
#
#   make env
#   $EDITOR .env.mainnet-rehearsal
#
# Keep this to a burner wallet only. Never use a production/admin wallet for
# this rehearsal, and never commit the filled `.env.mainnet-rehearsal`.
# =============================================================================

# ---- Required for live broadcast --------------------------------------------
# Use a reliable Ethereum mainnet RPC for broadcast. Public RPCs are okay for
# fork rehearsals but can rate-limit at the worst possible moment.
MAINNET_RPC_URL=

# Burner EOA private key. Fund with only enough ETH for this rehearsal.
DEV_PRIVATE_KEY=

# Skip inline explorer verification so contracts stay unverified during the
# private rehearsal. Set to 0 only if you also fill ETHERSCAN_API_KEY.
SKIP_VERIFY=1
ETHERSCAN_API_KEY=

# ---- Required deploy references ---------------------------------------------
# Ethereum mainnet Uniswap v4 PoolManager.
# Source: https://developers.uniswap.org/docs/protocols/v4/deployments
V4_POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90

# DeployFreshLocal requires URU/GEMU references for the fee/loyalty stack.
# For a private Ethereum-mainnet rehearsal, use the intended mainnet addresses
# if they exist, or purpose-built throwaway references if you are only testing
# the ETH launch path.
URU_TOKEN_ADDRESS=
GEMU_NFT_ADDRESS=
MIN_URU_FEE=1

# ---- Optional deploy identity ------------------------------------------------
# Leave commented out to let DeployFreshLocal default ADMIN/TREASURY to the
# broadcast sender. Do not use production Safe/admin values for a throwaway
# rehearsal.
# ADMIN=
# TREASURY=

# ---- Tiny launchpad economics ------------------------------------------------
# DeployFreshLocal reads these optional fee knobs. The mainnet rehearsal
# Makefile also exports these defaults if they are unset.
ALLOW_MAINNET_TINY_FEES=1
ERC20_FEE_WEI=100000000000000
NFT_FEE_WEI=100000000000000
ERC721A_FEE_WEI=100000000000000
ERC1155_FEE_WEI=100000000000000
MODULE_ADDON_WEI=0
HOOK_ADDON_WEI=0
GOV_ADDON_WEI=0

# LowerGradTarget: make new bonding curves graduate at 0.001 ETH for this
# private mainnet rehearsal. The script refuses Ethereum mainnet unless the ack
# is set.
ALLOW_MAINNET_TINY_TARGET=1
TARGET_ETH=1000000000000000

# PostDeploySmoke: launchAndBuy amount for the ERC20 curve smoke leg.
SMOKE_BUY_WEI=1000000000000000
SMOKE_GRADUATE=0

# ---- Safety rails consumed by Makefile ---------------------------------------
# Abort live targets above this gas price. Override at runtime if you
# deliberately want to run during a spike:
#   make mainnet-live MAX_GAS_PRICE_GWEI=5 ...
MAX_GAS_PRICE_GWEI=2

# Require the burner to have at least 0.03 ETH before the whole live sequence.
# Adjust if gas rises or you intentionally fund less.
MIN_BURNER_BALANCE_WEI=30000000000000000
