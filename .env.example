# =============================================================================
# urufu labs — env template. Copy to .env (never committed) and fill values.
# =============================================================================
# Launchpad is Robinhood-only (chain 4663). Other chain env vars removed
# 2026-08-07 — re-add if a chain gets re-enabled in wagmi + indexer.
# =============================================================================

# ---- RPC endpoints ----------------------------------------------------------
# Robinhood Chain (Arbitrum L2, chain IDs 4663 / 46630). Public RPCs are rate-limited;
# recommend swapping to an Alchemy endpoint for production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ---- Broadcast identity (NEVER commit) --------------------------------------
# Fund with ~0.5 ETH on Sepolia. Rotate to a multisig (see MULTISIG_ADMIN)
# post-broadcast; the deploy key should never be a long-term admin key.
DEV_PRIVATE_KEY=

# HandoffOwnership.s.sol transfers Router/Registry/factory ownership to this.
# Use a Safe multisig on the same chain.
MULTISIG_ADMIN=

# ---- Verification -----------------------------------------------------------
# Robinhood uses Blockscout, which accepts any string as the API key for public
# endpoints. Left as `none` here; swap for a real key once Blockscout Pro is up.
BLOCKSCOUT_API_KEY=none

# ---- Router deploy knobs (all optional; sensible defaults in the script) -----
# ADMIN=
# TREASURY=
# REGISTRAR=
# ERC20_FEE_WEI=
# MODULE_ADDON_WEI=
# HOOK_ADDON_WEI=
# GOV_ADDON_WEI=

# ---- NameRegistry deploy (DeployNameRegistry.s.sol) -------------------------
# Both fall back to the deploying key if unset. Post-deploy, transfer owner to a
# 2-of-3 multisig; treasury is where future name-registration sweeps land.
# REGISTRY_OWNER=
# REGISTRY_TREASURY=

# ---- v4 hook deploy (DeployHooks.s.sol) -------------------------------------
# Robinhood v4 PoolManager address (only chain we deploy hooks against today).
# Reference: https://developers.uniswap.org/docs/protocols/v4/deployments
V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
# ROBINHOOD_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
# ROBINHOOD_TESTNET_V4_POOL_MANAGER=
# PLATFORM=
# CREATOR=
# PLATFORM_BPS=100
# CREATOR_BPS=100
# ANTISNIPER_GATE_BLOCKS=5
# BUYBACK_TOKEN=
# BUYBACK_BPS=200

# ---- Graduator deploy (DeployGraduator.s.sol) -------------------------------
# One Graduator per chain, immutable (poolManager, defaultHook, fee, tickSpacing).
# Broadcast per chain, then owner of CurveFactory calls setGraduator(new).
# DEFAULT_HOOK=                     # usually MultiHookHost from DeployHooks
# GRADUATOR_FEE=3000                # 0.3%
# GRADUATOR_TICK_SPACING=60
# WIRE_INTO_FACTORY=0               # 1 = also call CurveFactory.setGraduator in-script
# CURVE_FACTORY=                    # optional; auto-read from deployment.<chainid>.json

# ---- Web + indexer address inputs ------------------------------------------
# The web app compiles addresses in from `web/src/lib/config.ts` (written by
# `tools/sync-addresses.mjs`) — it does NOT read these envs directly.
#
# The indexer (`indexer/ponder.config.ts`) reads addresses per-chain via
# `<PREFIX>_<CONTRACT>_ADDRESS`. Only ROBINHOOD_ prefix is live today.

# --- Robinhood (chain id 4663) — canonical launchpad chain post-migration.
# After running the RH deploy runbook (Flywheel + MigrateToV2Hook + CurveFactoryV2 +
# RouterV2), `node tools/sync-addresses.mjs robinhood` prints an env block — paste
# the values below and mirror to Railway. Note: ROUTER = RouterV2 address (not the
# legacy Router), CURVE_FACTORY = the WL-aware CurveFactoryV2.
ROBINHOOD_NAME_REGISTRY_ADDRESS=
ROBINHOOD_ROUTER_ADDRESS=
ROBINHOOD_ERC20_FACTORY_ADDRESS=
ROBINHOOD_ERC721A_FACTORY_ADDRESS=
ROBINHOOD_ERC1155_FACTORY_ADDRESS=
ROBINHOOD_CURVE_FACTORY_ADDRESS=
ROBINHOOD_POOL_MANAGER_ADDRESS=0x8366a39cc670b4001a1121b8f6a443a643e40951
ROBINHOOD_V4_SWAP_ROUTER_ADDRESS=
ROBINHOOD_MULTI_HOOK_HOST_ADDRESS=
ROBINHOOD_FEE_SPLITTER_ADDRESS=
ROBINHOOD_URU_BUYBACK_VAULT_ADDRESS=
ROBINHOOD_URU_DEPOSIT_SINK_ADDRESS=
ROBINHOOD_NFT_REVENUE_VAULT_ADDRESS=
ROBINHOOD_GEMU_NFT_ADDRESS=0x60cB7082c8C14B4237C6a24c65E7C2E7abe2Bd17

# --- Robinhood testnet: mirror the same keys with ROBINHOOD_TESTNET_ prefix
#     when the staging environment comes online.

NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_COMPILE_SERVICE_URL=http://localhost:3001

# Postgres connection string — set in Railway (auto-injected by the Postgres addon
# as DATABASE_URL / DATABASE_PRIVATE_URL). When present, ponder switches from local
# pglite to Postgres automatically. Leave unset for local dev.
DATABASE_URL=
# Per-chain RPC overrides for wagmi transports. Robinhood-only; non-RH chains
# stay wired in wagmi (grayed out in UI) but fall back to viem's default public
# RPC when their NEXT_PUBLIC_*_RPC_URL is unset.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=

# ---- Flywheel deploy (DeployFlywheel.s.sol) ---------------------------------
# URU + urufu gemu NFT canonical addresses on Robinhood.
URU_TOKEN_ADDRESS=0x9fbe210007dDd8389f98d0253018e65CC48b9D24
GEMU_NFT_ADDRESS=0x60cB7082c8C14B4237C6a24c65E7C2E7abe2Bd17
# The ROBINHOOD_-prefixed vars are what the indexer's RH subscription and the
# compile-service rewards keeper read explicitly. Set them even though they
# duplicate the values above: the indexer's ecosystemTokenNet resolves per-chain
# keys separately, and the rewards keeper refuses to fall back to the bare
# GEMU_NFT_ADDRESS. Without these, RH flywheel indexing silently disables.
ROBINHOOD_URU_ADDRESS=0x9fbe210007dDd8389f98d0253018e65CC48b9D24
ROBINHOOD_GEMU_NFT_ADDRESS=0x60cB7082c8C14B4237C6a24c65E7C2E7abe2Bd17
# See docs/references/ecosystem-contracts.md for the full address book.
# URU balance required for the "URU holder" fee-discount tier. Default 100,000 URU.
URU_THRESHOLD=100000000000000000000000
# Cooldown between FeeSplitter config changes (default 2 days).
SPLITTER_CONFIG_DELAY=172800
# Platform's bps of NFT secondary-royalty ETH (default 500 = 5%). Launchers keep the rest.
# Frozen at RoyaltyRouterFactory construction — can't rotate later.
ROYALTY_PLATFORM_BPS=500

# ---- Flywheel configuration (ConfigureFlywheel.s.sol) -----------------------
# Address that will trigger buybacks on UruBuybackVault (bot / EOA / multisig).
# KEEPER=
# Uniswap Universal Router the keeper is allowed to route swaps through.
#   Robinhood:     0x8876789976dEcBfCbBbe364623C63652db8C0904   ← canonical
# Always verify against Uniswap docs before setting on mainnet.
# SWAP_TARGET=
# Optional split overrides (must sum to 10 000). Defaults: 4000 / 3500 / 2500.
# URU_BUYBACK_BPS=4000
# NFT_REVENUE_BPS=3500
# TREASURY_BPS=2500

# ---- IPFS metadata (optional) ------------------------------------------------
# Pinata JWT — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. The compile-service
# proxies pin requests so the JWT never reaches the client bundle. Set the same value
# on Railway's compile-service env as PINATA_JWT. When unset, image uploads still work
# locally (base64 → localStorage) but images won't render on other browsers.
PINATA_JWT=
# Public gateway host — safe as NEXT_PUBLIC_ (no secret). Used only to construct
# read URLs for pinned CIDs.
NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud

# ---- Profile avatars ---------------------------------------------------------
# MORALIS_API_KEY stays on the Railway compile-service. It powers the read-only
# wallet NFT picker across Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain,
# Avalanche, Gnosis, Linea, Cronos, Ronin, and Moonbeam. The frontend never sees
# this key; choosing an NFT only stores its original image URL + provenance.
MORALIS_API_KEY=
# Vercel injects this when you create a *public* Blob store for the web project.
# Keep it in the Vercel project only (do not copy it to Railway). Profile uploads go
# browser → Blob directly after a wallet signature, avoiding the old 400–512KB IPFS path.
BLOB_READ_WRITE_TOKEN=

# ---- Flywheel rewards publishing (compile-service) --------------------------
# Vault address on RH — read by /rewards routes. Populated by
# tools/sync-addresses.mjs writing to web/src/lib/config.ts (FLYWHEEL.robinhood);
# mirror the value here for the compile-service env as
# ROBINHOOD_NFT_REVENUE_VAULT_ADDRESS.
# KEEPER_PRIVATE_KEY: signs the vault.addEpoch tx server-side. Same wallet is the
# vault OWNER today; if you rotate ownership, rotate this key too. NEVER commit.
KEEPER_PRIVATE_KEY=
# KEEPER_TRIGGER_SECRET: HMAC-style secret required in `x-keeper-secret` header
# on POST /rewards/:chain/publish. Anyone with this can trigger a publish, but
# the on-chain call still signs from KEEPER_PRIVATE_KEY so blast radius is
# bounded to "publish an epoch" (never "drain the vault"). Rotate if leaked.
KEEPER_TRIGGER_SECRET=
# INDEXER_URL: internal URL the compile-service uses to query Ponder for the
# snapshot. On Railway, use the indexer service's private URL. Falls back to
# NEXT_PUBLIC_INDEXER_URL if unset.
INDEXER_URL=

# ---- Indexer ----------------------------------------------------------------
# Which chains this indexer instance subscribes to. Comma-separated slug list.
# One Ponder process handles every chain listed here — no more one-service-per-chain.
# A chain listed here that's missing its RPC or contract addresses is silently
# skipped, so enabling a new chain is an env-var change, not a redeploy.
#
# Slugs: robinhood | robinhood-testnet (other chains removed 2026-08-07)
#
# RH is the canonical launchpad chain. RH's public RPC is FREE (no Alchemy CU
# cost), so RH-only indexing runs at ~$0/day.
INDEXER_CHAINS=robinhood
# Legacy single-chain selector — still honored. When set, unlocks reading the
# unprefixed NEXT_PUBLIC_*_ADDRESS env vars above as a fallback for that chain.
# Prefer INDEXER_CHAINS for anything new; leave INDEXER_CHAIN blank in fresh setups.
INDEXER_CHAIN=

# Per-chain deploy block of the FIRST contract in the stack (Router usually) so Ponder
# doesn't rescan the whole chain. Set one for every chain in INDEXER_CHAINS. For the
# RH V2 stack (RouterV2 + CurveFactoryV2), use the block those were deployed at —
# NOT the original Phase1 block. `sync-addresses.mjs robinhood` prints the correct
# value after the deploy.
PONDER_START_BLOCK_ROBINHOOD=
# PONDER_START_BLOCK_BASE=
# PONDER_START_BLOCK_SEPOLIA=
# PONDER_START_BLOCK_MAINNET=
# PONDER_START_BLOCK_BASE_SEPOLIA=
# PONDER_START_BLOCK_ROBINHOOD_TESTNET=

# ---- Compile service --------------------------------------------------------
PORT=3001

# ---- X (Twitter) OAuth 2.0 --------------------------------------------------
# Confidential-client app credentials from developer.x.com. Callback URLs
# registered on the app MUST match one of the ALLOWED_ORIGINS in
# web/src/lib/xAuth.ts (prod: urufulabs.xyz; dev: localhost:3000).
NEXT_PUBLIC_X_CLIENT_ID=
X_CLIENT_SECRET=
# HMAC secret used to sign the per-attempt `x-oauth-<random>` cookie the
# /api/auth/x/start route mints. Must be >= 32 chars in production.
X_OAUTH_COOKIE_SECRET=
# Bearer secret shared between the web app (callback + disconnect routes) and
# the compile-service `/profile/:address/x-verified` endpoint. This is the
# ONLY path that can mint / clear verified X binding fields. Must match on
# both services in prod; must be >= 32 chars.
X_VERIFY_SHARED_SECRET=
