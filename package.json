{
  "name": "launchpad",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:compile-service": "pnpm --filter compile-service dev",
    "dev:indexer": "pnpm --filter indexer dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "contracts:test": "cd contracts && forge test",
    "contracts:build": "cd contracts && forge build",
    "contracts:coverage": "cd contracts && forge coverage --report summary",
    "contracts:fmt": "cd contracts && forge fmt",
    "contracts:fmt:check": "cd contracts && forge fmt --check",
    "contracts:snapshot": "cd contracts && forge snapshot",
    "contracts:install": "cd contracts && bash install-deps.sh",
    "contracts:security": "cd contracts && bash security.sh",
    "splice": "node --experimental-strip-types --disable-warning=ExperimentalWarning compile-service/src/cli.ts",
    "splice:antibot": "pnpm splice compile-service/fixtures/erc20-antibot.json contracts/src/templates/composed/ERC20WithAntiBotGen.sol",
    "splice:feeontransfer": "pnpm splice compile-service/fixtures/erc20-feeontransfer.json contracts/src/templates/composed/ERC20WithFeeOnTransferGen.sol",
    "contracts:rehearse:registry": "cd contracts && bash rehearse-deploy.sh DeployNameRegistry ${CHAIN:-sepolia}",
    "contracts:rehearse:flywheel": "cd contracts && bash rehearse-deploy.sh DeployFlywheel ${CHAIN:-robinhood}",
    "contracts:rehearse:combos": "cd contracts && bash rehearse-combos.sh ${CHAIN:-sepolia}",
    "contracts:rehearse:fresh": "cd contracts && bash rehearse-deploy.sh DeployFreshLocal ${CHAIN:-robinhood}",
    "contracts:deploy:fresh": "cd contracts && bash deploy.sh Fresh ${CHAIN:-robinhood}",
    "contracts:deploy:registry": "cd contracts && bash deploy.sh NameRegistry ${CHAIN:-robinhood}",
    "contracts:deploy:v4router": "cd contracts && bash deploy.sh V4SwapRouter ${CHAIN:-robinhood}",
    "contracts:deploy:router": "cd contracts && bash deploy.sh Router ${CHAIN:-robinhood}",
    "contracts:deploy:flywheel": "cd contracts && bash deploy.sh Flywheel ${CHAIN:-robinhood}",
    "contracts:configure:flywheel": "cd contracts && bash deploy.sh ConfigureFlywheel ${CHAIN:-robinhood}",
    "contracts:deploy:chunkydefaults": "cd contracts && bash deploy.sh SetChunkyDefaults ${CHAIN:-robinhood}",
    "contracts:lower-grad-target": "cd contracts && bash deploy.sh LowerGradTarget ${CHAIN:-robinhood}",
    "contracts:smoke": "cd contracts && bash deploy.sh PostDeploySmoke ${CHAIN:-robinhood}",
    "contracts:handoff": "cd contracts && bash deploy.sh HandoffOwnership ${CHAIN:-robinhood}",
    "contracts:verify:wiring": "cd contracts && forge script script/VerifyWiring.s.sol:VerifyWiring --rpc-url ${RPC_URL:-$ROBINHOOD_RPC_URL} --sig 'run()'"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "prettier-plugin-solidity": "^1.4.0"
  }
}
