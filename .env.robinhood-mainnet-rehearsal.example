# =============================================================================
# urufu launchpad - private Robinhood Chain mainnet tiny rehearsal
# =============================================================================
# Copy to `.env.robinhood-mainnet-rehearsal` and fill the blanks:
#
#   make env
#   $EDITOR .env.robinhood-mainnet-rehearsal
#
# Keep this to a burner wallet only. Never use a production/admin wallet for
# this rehearsal, and never commit the filled `.env.robinhood-mainnet-rehearsal`.
# =============================================================================

# ---- Required for live broadcast --------------------------------------------
# Robinhood Chain mainnet (chain id 4663). The public RPC is fine for fork
# rehearsals; use a reliable endpoint for live broadcast if available.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Burner EOA private key. Fund with only enough ETH for this rehearsal.
DEV_PRIVATE_KEY=

# Skip inline Blockscout verification so contracts stay unverified during the
# private rehearsal.
SKIP_VERIFY=1
BLOCKSCOUT_API_KEY=none

# ---- Required deploy references ---------------------------------------------
# Robinhood Chain mainnet Uniswap v4 PoolManager. DeployFreshLocal also has a
# chain-id 4663 stale-env guard that refuses any other PoolManager address.
V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# Canonical Robinhood URU/GEMU references consumed by DeployFreshLocal's
# fee/loyalty stack. MIN_URU_FEE is deliberately tiny for this private rehearsal.
URU_TOKEN_ADDRESS=0x9fbe210007dDd8389f98d0253018e65CC48b9D24
GEMU_NFT_ADDRESS=0x60cB7082c8C14B4237C6a24c65E7C2E7abe2Bd17
MIN_URU_FEE=1

# ---- Optional deploy identity ------------------------------------------------
# Leave commented out to let DeployFreshLocal default ADMIN/TREASURY to the
# broadcast sender. Do not use production Safe/admin values for a throwaway
# rehearsal.
# ADMIN=
# TREASURY=

# ---- Tiny launchpad economics ------------------------------------------------
# DeployFreshLocal reads these optional fee knobs. The Makefile also exports
# these defaults if they are unset.
ALLOW_ROBINHOOD_MAINNET_TINY_FEES=1
ERC20_FEE_WEI=100000000000000
NFT_FEE_WEI=100000000000000
ERC721A_FEE_WEI=100000000000000
ERC1155_FEE_WEI=100000000000000
MODULE_ADDON_WEI=0
HOOK_ADDON_WEI=0
GOV_ADDON_WEI=0

# LowerGradTarget: make new bonding curves graduate at 0.001 ETH for this
# private Robinhood mainnet rehearsal. The script refuses chain id 4663 unless
# this acknowledgement is set.
ALLOW_ROBINHOOD_MAINNET_TINY_TARGET=1
TARGET_ETH=1000000000000000

# PostDeploySmoke: launchAndBuy amount for the ERC20 curve smoke leg.
SMOKE_BUY_WEI=1000000000000000
SMOKE_GRADUATE=0

# ---- Safety rails consumed by Makefile ---------------------------------------
# Abort live targets above this gas price. Override at runtime if you
# deliberately want to run during a spike:
#   make rh-mainnet-live MAX_GAS_PRICE_GWEI=5 ...
MAX_GAS_PRICE_GWEI=2

# Require the burner to have at least 0.03 ETH before the whole live sequence.
# Adjust if gas rises or you intentionally fund less.
MIN_BURNER_BALANCE_WEI=30000000000000000
